local function releaseEsp(obj)
    obj.inUse = false
    obj.frame.Visible = false
end

local function updateESP()
    for _, obj in ipairs(espPool) do
        if obj.inUse then releaseEsp(obj) end
    end
    if not CFG.esp then return end
    local myInfo = getTeamInfo(LocalPlayer)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isPlayerAlive(player) and player.Character then
            local part = getTargetPart(player.Character)
            if part then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local ti = getTeamInfo(player)
                    local pvp = isPVP(myInfo, ti)
                    local obj = getEspObj()
                    obj.frame.Size = UDim2.new(0, 80, 0, 80)
                    obj.frame.Position = UDim2.new(0, sp.X - 40, 0, sp.Y - 40)
                    obj.nameLabel.Text = player.DisplayName
                    obj.teamLabel.Text = ti.teamName
                    obj.teamLabel.TextColor3 = ti.teamColor
                    obj.teamLabel.Visible = true
                    if pvp then
                        obj.pvpLabel.Text = "[PVP]"
                        obj.pvpLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                        obj.pvpLabel.Visible = true
                    else
                        obj.pvpLabel.Visible = false
                    end
                    local hp, pct, knocked = getHealthInfo(player)
                    obj.healthFill.Size = UDim2.new(pct, 0, 1, 0)
                    obj.healthFill.BackgroundColor3 = knocked and Color3.fromRGB(185, 0, 0) or Color3.fromRGB(255, 255, 255)
                    obj.healthBar.Visible = true
                end
            end
        end
    end
end

local function updateAimCircle()
    if CFG.showAimCircle and (CFG.aimbot or CFG.ragebot) then
        aimCircle.Size = UDim2.new(0, CFG.aimbotFOV * 2, 0, CFG.aimbotFOV * 2)
        aimCircle.Visible = true
    else
        aimCircle.Visible = false
    end
end

local function updateTargetName()
    local target = currentTarget or ragebotTarget
    if target and CFG.showTargetName and (CFG.aimbot or CFG.ragebot) then
        targetNameLabel.Text = target.DisplayName
        targetNameLabel.Visible = true
    else
        targetNameLabel.Visible = false
    end
end

RunService.Heartbeat:Connect(function()
    if CFG.ragebot then
        updateRagebot()
    end
end)

RunService.RenderStepped:Connect(function()
    updateESP()
    updateAimCircle()
    if CFG.aimbot then
        updateAimbot()
    else
        currentTarget = nil
    end
    updateTargetName()
end)

