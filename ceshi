        p:SetAttribute("vx", math.random(-100, -30) / 10)
        p:SetAttribute("vy", math.random(30, 100) / 10)
        p:SetAttribute("swayAmp", math.random(20, 60))
        p:SetAttribute("swayFreq", math.random(0.5, 3))
        p:SetAttribute("swayPhase", math.random(0, 360))
        p:SetAttribute("rotSpeed", math.random(-180, 180))
        p:SetAttribute("life", 0)
        p:SetAttribute("maxLife", math.random(10, 20))
        p.Position = UDim2.new(startX / 100, 0, startY / 100, 0)
        table.insert(particles, p)
    end
    for _ = 1, 50 do createParticle() end
    sp(function() w(duration or 12) spawnActive = false end)
    RunService.RenderStepped:Connect(function(dt)
        if spawnActive and #particles < maxParticles and math.random() < 0.7 then createParticle() end
        for i = #particles, 1, -1 do
            local p = particles[i]
            if not p or not p.Parent then table.remove(particles, i)
            else
                local life = p:GetAttribute("life") + dt
                p:SetAttribute("life", life)
                local sway = math.sin(life * p:GetAttribute("swayFreq") * math.pi + p:GetAttribute("swayPhase")) * p:GetAttribute("swayAmp")
                local curX = p.Position.X.Scale * 100
                local curY = p.Position.Y.Scale * 100
                p.Rotation = p.Rotation + p:GetAttribute("rotSpeed") * dt
                local newX = curX + (p:GetAttribute("vx") + sway) * dt * 0.5
                local newY = curY + p:GetAttribute("vy") * dt
                p.Position = UDim2.new(newX / 100, 0, newY / 100, 0)
                if curX < -30 or curY > 130 or life > p:GetAttribute("maxLife") then p:Destroy() table.remove(particles, i) end
