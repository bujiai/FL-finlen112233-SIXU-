local ragebotTarget = nil
local function updateRagebot()
    if not CFG.ragebot or isReloading then return end
    local tool = getLocalEquippedTool()
    if not tool or type(tool.GetId) ~= "function" or not tool.toolState then return end
    if tool.toolState.ammo <= 0 then
        if CFG.autoReload then autoReload(tool) end
        return
    end
    local target = getClosestPlayerByDistance()
    ragebotTarget = target
    if not target then return end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetHead = target.Character:FindFirstChild("Head")
    if not myRoot or not targetHead then return end

    tool.toolState.ammo = tool.toolState.ammo - 1
    updateAmmoDisplay(tool)

    local toolId = tool:GetId()
    local muzzleVel = tool.projectile and tool.projectile.muzzleVelocity
    local origin = myRoot.Position + Vector3.new(0, 2, 0)
    local targetPos = targetHead.Position
    local direction = (targetPos - origin).Unit
    local projectileId = NUID and NUID() or generateProjectileId()
    local compressed = MathUtil and MathUtil.CompressCFrame and MathUtil.CompressCFrame(CFrame.lookAlong(origin, direction)) or compressCFrame(CFrame.lookAlong(origin, direction))

    fireServer("shoot", toolId, compressed, {{projectileId, compressed}})

    if CFG.bulletTrace then
        spawnBulletTracer(origin, targetPos)
    end

    fireServer("registerProjectileHits", projectileId, toolId, {
        {
            normal = -direction,
            direction = direction,
            hitName = "Head",
            source = "Bullet",
            userId = target.UserId,
            massLimit = 5,
            ownerId = LocalPlayer.UserId,
            position = targetPos,
            processedPlayerId = LocalPlayer.UserId,
            hit = targetHead,
            speed = muzzleVel,
            collisionPoint = targetPos,
            material = Enum.Material.Plastic,
            hitType = "player",
        }
    })
end

local function updateAimbot()
    if not CFG.aimbot then
        currentTarget = nil
        return nil
    end
    local target = getClosestPlayerToFoV()
    currentTarget = target
    if target and target.Character then
        local part = getTargetPart(target.Character)
        if part then
            local targetPos = part.Position
            local currentLook = Camera.CFrame.LookVector
            local toTarget = (targetPos - Camera.CFrame.Position).Unit
            local newLook = currentLook:Lerp(toTarget, 0.35)
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + newLook)
        end
    end
    return target
end

