local function safeIsA(obj, className)
    if typeof(obj) ~= "Instance" then return false end
    local ok, result = pcall(function() return obj:IsA(className) end)
    return ok and result
end

local bypassActive = false

local function setupBypass()
    if bypassActive then return end
    bypassActive = true

    local gmMt = getrawmetatable and getrawmetatable(game)
    if not gmMt then
        local ok, gm = pcall(function() return getmetatable(game) end)
        if ok then gmMt = gm end
    end

    if gmMt then
        if setreadonly then setreadonly(gmMt, false) end
        local oldNamecall = gmMt.__namecall
        if oldNamecall then
            gmMt.__namecall = function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""
                if (method == "FireServer" or method == "InvokeServer") and not reentrant then
                    local args = {...}
                    if type(args[1]) == "string" and blockedRemotes[args[1]] then
                        return nil
                    end
                end
                return oldNamecall(self, ...)
            end
        end
        local oldNI = gmMt.__newindex
        if oldNI then
            gmMt.__newindex = function(self, key, value)
                if not wsReentrant and safeIsA(self, "Humanoid") and (key == "WalkSpeed" or key == "JumpPower" or key == "JumpHeight" or key == "HipHeight") then return nil end
                if not velReentrant and safeIsA(self, "BasePart") and (key == "AssemblyLinearVelocity" or key == "AssemblyAngularVelocity") then return nil end
                return oldNI(self, key, value)
            end
        end
        local oldIdx = gmMt.__index
        if oldIdx then
            gmMt.__index = function(self, key)
                if self == LocalPlayer and (key == "IdleTime" or key == "UserIdleTime") then return 0 end
                return oldIdx(self, key)
            end
        end
        if setreadonly then setreadonly(gmMt, true) end
    end

    if hookmetamethod then
        local oldNI
        oldNI = hookmetamethod(game, "__newindex", function(self, key, value)
            if not wsReentrant and safeIsA(self, "Humanoid") and (key == "WalkSpeed" or key == "JumpPower" or key == "JumpHeight" or key == "HipHeight") then return nil end
            if not velReentrant and safeIsA(self, "BasePart") and (key == "AssemblyLinearVelocity" or key == "AssemblyAngularVelocity") then return nil end
            return oldNI(self, key, value)
        end)
        local oldIdx
        oldIdx = hookmetamethod(game, "__index", function(self, key)
            if self == LocalPlayer and (key == "IdleTime" or key == "UserIdleTime") then return 0 end
            return oldIdx(self, key)
        end)
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod and getnamecallmethod() or ""
            if method == "FireServer" and not reentrant then
                local args = {...}
                if type(args[1]) == "string" and blockedRemotes[args[1]] then return nil end
            end
            return oldNC(self, ...)
        end)
    end

    pcall(function()
        local oldTF = table.freeze
        local oldTIF = table.isfrozen
        if oldTF then
            table.freeze = function(t) return t end
        end
        if oldTIF then
            table.isfrozen = function(t) return false end
        end
    end)
end

