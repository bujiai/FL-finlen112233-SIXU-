
-- ==================================================================
--  CX 绕过层（元表 hook + Network 收口）
-- ==================================================================
CX_META = CX_META or {}
CX_META.Enabled = true
CX_META.Silent = true          -- 静默：不弹任何通知
CX_META.UseMetaHooks = false   -- ⚠️ 默认【不挂】元表 hook（改 game 元表最容易被查）
CX_META.Dropped = 0
CX_META.Blocked = {
	fling = true, resetVelocity = true, spectatePlayer = true,
	reconnectPlayer = true, resetCharacter = true,
}
CX_META.GuardSpeed = true
CX_META.GuardVelocity = true
CX_META.Network = nil
CX_META._nc = nil
CX_META._ni = nil

local _A = {
	getrawmetatable   = getrawmetatable,
	setreadonly       = setreadonly,
	getnamecallmethod = getnamecallmethod,
	hookmetamethod    = hookmetamethod,
}

local function _drop(name)
	if CX_META.Enabled and type(name) == "string" and CX_META.Blocked[name] then
		CX_META.Dropped = CX_META.Dropped + 1
		return true
	end
	return false
end

function CX_META.Install()
	-- ① Network 收口（唯一能拿到真名的地方）
	pcall(function()
		local net = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared")
			:WaitForChild("Core"):WaitForChild("Network"))
		if type(net) == "table" then
			CX_META.Network = net
			local oldFire = net.FireServer
			if type(oldFire) == "function" then
				net.FireServer = function(name, ...)
					if _drop(name) then return nil end
					return oldFire(name, ...)
				end
			end
			local oldInvoke = net.InvokeServer
			if type(oldInvoke) == "function" then
				net.InvokeServer = function(name, ...)
					if _drop(name) then return nil end
					return oldInvoke(name, ...)
				end
			end
		end
	end)

	-- ② 元表 hook（默认关：改 game 元表最容易被反作弊查到）
	if not CX_META.UseMetaHooks then return CX_META.Network ~= nil end
	local ok, mt = pcall(_A.getrawmetatable, game)
	if not ok or type(mt) ~= "table" then return CX_META.Network ~= nil end
	local oldNC = rawget(mt, "__namecall")
	local oldNI = rawget(mt, "__newindex")
	pcall(_A.setreadonly, mt, false)

	if type(oldNC) == "function" and not CX_META._nc then
		CX_META._nc = function(self, ...)
			if CX_META.Enabled and _A.getnamecallmethod() == "FireServer" then
				if _drop(select(1, ...)) then return nil end
			end
			return oldNC(self, ...)
		end
		pcall(function() mt.__namecall = CX_META._nc end)
	end

	if type(oldNI) == "function" and not CX_META._ni then
		CX_META._ni = function(self, key, value)
			if CX_META.Enabled then
				local okI, isInst = pcall(function() return typeof(self) == "Instance" end)
				if okI and isInst then
					if CX_META.GuardSpeed and key == "WalkSpeed" then
						local okH, isHum = pcall(function() return self:IsA("Humanoid") end)
						if okH and isHum then return nil end
					end
					if CX_META.GuardVelocity and (key == "AssemblyLinearVelocity"
						or key == "AssemblyAngularVelocity") then
						local okP, isPart = pcall(function() return self:IsA("BasePart") end)
						if okP and isPart then return nil end
					end
				end
			end
			return oldNI(self, key, value)
		end
		pcall(function() mt.__newindex = CX_META._ni end)
	end

	pcall(_A.setreadonly, mt, true)

	-- ③ 老执行器退路
	if not CX_META._nc and type(_A.hookmetamethod) == "function" then
		pcall(function()
			local old = _A.hookmetamethod(game, "__namecall", function(self, ...)
				if _drop(select(1, ...)) then return nil end
				return old(self, ...)
			end)
			CX_META._nc = true
		end)
	end

	return true
end

pcall(CX_META.Install)


-- ==================================================================
--  CX 状态伪造层（CX_STATE）
--
--  查 dump 结论：客户端**没有**位置/速度上报接口 —— 位置只走引擎复制，
--  服务端直接读，客户端改不了（这也是"飞行被拉回"的根本原因）。
--
--  但客户端**有状态上报**：
--      Network.FireServer("replicatePlayerProperty", <属性名>, <值>)
--  来自 `ReplicatedStorage.Client.Wanted.Objects.ClientPlayer`：
--      function value34.ReplicatePlayerProperty(p172, p173)
--          if p172.player == LocalPlayer then
--              value26.FireServer("replicatePlayerProperty", p173, p172.playerState[p173]);
--          end
--      end
--  dump 里出现过的属性名：sprinting / ragdolled / equipped / arrested / cellphone …
--  （还有 Sprint / Jump 这类设置项）
--
--  ⭐ 思路：服务端判"你该跑多快"很可能就是看这些状态（走路 / 冲刺 / 载具）。
--     那就**永远上报最快的那一档** —— 把 sprinting 之类的字段钉成 true。
--     这不改位置，只是让服务端"允许"的速度上限更高，从而**减少被拉回**。
-- ==================================================================
CX_STATE = CX_STATE or {}
CX_STATE.Enabled = false         -- ⚠️ 默认【关】：伪造状态会被服务端交叉比对，封号高危
CX_STATE.ForceSprint = true      -- 永远上报"正在冲刺"
CX_STATE.Log = {}                -- 见过哪些 playerState 属性名
CX_STATE.Forged = 0
CX_STATE._hooked = false

-- 要把这些属性钉成什么值
CX_STATE.Pin = {
	sprinting = true,
	walking = false,
	isRunning = true,
	ragdolled = false,
	crouching = false,
}

function CX_STATE.Install()
	if CX_STATE._hooked then return true end
	local ok, net = pcall(function()
		return require(game:GetService("ReplicatedStorage"):WaitForChild("Shared")
			:WaitForChild("Core"):WaitForChild("Network"))
	end)
	if not ok or type(net) ~= "table" or type(net.FireServer) ~= "function" then
		return false
	end
	local prev = net.FireServer
	net.FireServer = function(name, key, value, ...)
		if CX_STATE.Enabled and name == "replicatePlayerProperty" and type(key) == "string" then
			CX_STATE.Log[key] = (CX_STATE.Log[key] or 0) + 1
			local pin = CX_STATE.Pin[key]
			if pin ~= nil then
				CX_STATE.Forged = CX_STATE.Forged + 1
				return prev(name, key, pin, ...)
			end
		end
		return prev(name, key, value, ...)
	end
	CX_STATE._hooked = true
	return true
end

function CX_STATE.Report()
	local list = {}
	for k, v in pairs(CX_STATE.Log) do list[#list + 1] = k .. "×" .. v end
	table.sort(list)
	return string.format("伪造 %d 次 | 见过的状态属性: %s",
		CX_STATE.Forged, #list > 0 and table.concat(list, " ") or "（还没有）")
end

pcall(CX_STATE.Install)


-- ==================================================================
--  容器/保险箱破解（CX_CRACK）
--
--  ⭐ 挖到底的结论：**密码校验完全在客户端**。
--  `ClientGizmo.Gizmos.WorldSafe.Interact()`：
--      value:StartKeypadSequence({
--          position = value11.position,
--          numKeys  = value11.properties.numKeys or -1,
--          successFunc = function()                                  -- ← 客户端自己判密码对不对
--              value6.FireServer("gizmoInteraction", value11.objectId, "OpenSafe")
--          end
--      })
--  ⇒ 服务端收到的只有 `("gizmoInteraction", objectId, "OpenSafe")`，
--    **payload 里没有密码** ⇒ 服务端根本无从校验 ⇒ 直接发这句就能开。
--
--  客户端唯一的门：`if LocalPlayer:GetAttribute("currentTeam") == "police"` ——
--  警察不能抢（那是**本地**提示，不影响发包）。所以非警察身份直接发就行。
--
--  同类容器（dump 全扫出来的动词表）：
--      gizmoType 含 Safe        → gizmoInteraction(id, "OpenSafe")
--      Suitcase / ShippingCrate → gizmoInteraction(id, "open")
--      MilitaryChest            → gizmoInteraction(id, "Open")
--      PelicanCase              → gizmoInteraction(id, "GetTool")
--      PC Block                 → gizmoInteraction(id, "TakeFlashDrive" / "Search")
--      LockedMilitaryCrate      → propInteraction(id, "hack")
--      JewelryVaultDoor         → propInteraction(id, "dismantle" / "unjam" / "placeDrill")
--      Door / DestructibleGarage→ propInteraction(id, "toggle")
--
--  objectId / gizmoType 都是实例上的**属性**（_initModel 里 SetAttribute 挂的），
--  容器挂在 `workspace.Local.Gizmos` / `workspace.Local.Props` 下。
-- ==================================================================
CX_CRACK = CX_CRACK or {}
CX_CRACK.Radius   = 60        -- 扫描半径（客户端提示距离是 14，服务端是否校验未知）
CX_CRACK.Interval = 0.35      -- 每个目标之间的间隔（别刷爆 rateLimit）
CX_CRACK.Done     = 0
CX_CRACK.Failed   = 0
CX_CRACK.LastErr  = nil
CX_CRACK._busy    = false

-- 按 gizmoType / ClassName 决定发什么
local GIZMO_VERB = {
	Safe = "OpenSafe", GasStationSafe = "OpenSafe", QuestSafe = "OpenSafe",
	Suitcase = "open", ShippingCrate = "open", MilitaryChest = "Open",
	PelicanCase = "GetTool", Briefcase = "open",
}
local PROP_VERB = {
	LockedMilitaryCrate = "hack", JewelryVaultDoor = "dismantle",
	VaultDoor = "toggle", Door = "toggle", DestructibleGarage = "toggle",
}

local function fire(name, ...)
	local net = CX_META and CX_META.Network
	if net and type(net.FireServer) == "function" then
		net.FireServer(name, ...)
		return true
	end
	return false
end

-- 收集范围内所有带 objectId 的容器
function CX_CRACK.Collect()
	local out = {}
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return out end
	local root = workspace:FindFirstChild("Local")
	if not root then return out end

	local seen = 0
	for _, d in ipairs(root:GetDescendants()) do
		seen = seen + 1
		if seen > 40000 then break end
		local ok, id = pcall(function() return d:GetAttribute("objectId") end)
		if ok and type(id) == "string" then
			local ok2, gt = pcall(function() return d:GetAttribute("gizmoType") end)
			local ok3, pos = pcall(function()
				if d.PrimaryPart then return d.PrimaryPart.Position end
				if d:IsA("BasePart") then return d.Position end
				return nil
			end)
			if ok3 and pos then
				local dist = (pos - hrp.Position).Magnitude
				if dist <= CX_CRACK.Radius then
					out[#out + 1] = {
						id = id,
						gizmoType = ok2 and type(gt) == "string" and gt or nil,
						class = d.ClassName,
						dist = dist,
					}
				end
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end

-- 决定某个目标该发什么
function CX_CRACK.VerbFor(t)
	if t.gizmoType then
		for k, v in pairs(GIZMO_VERB) do
			if string.find(t.gizmoType, k, 1, true) then return "gizmoInteraction", v end
		end
	end
	for k, v in pairs(PROP_VERB) do
		if t.class == k then return "propInteraction", v end
	end
	return nil, nil
end

-- 一键破解范围内所有容器
function CX_CRACK.RunAll()
	if CX_CRACK._busy then return 0 end
	CX_CRACK._busy = true
	local targets = CX_CRACK.Collect()
	local n = 0
	for _, t in ipairs(targets) do
		local verb, action = CX_CRACK.VerbFor(t)
		if verb then
			if fire(verb, t.id, action) then
				CX_CRACK.Done = CX_CRACK.Done + 1
				n = n + 1
			else
				CX_CRACK.Failed = CX_CRACK.Failed + 1
				CX_CRACK.LastErr = "Network 未挂上"
			end
			task.wait(CX_CRACK.Interval)
		end
	end
	CX_CRACK._busy = false
	return n
end

function CX_CRACK.Status()
	return string.format("已破解 %d 个 / 失败 %d | 半径 %.0f | %s",
		CX_CRACK.Done, CX_CRACK.Failed, CX_CRACK.Radius,
		tostring(CX_CRACK.LastErr or "ok"))
end

-- ===================================================================
--  弹道绘制（FL_TRACER）
--
--  视觉照搬 csgo 版那套「破空」三层 Beam（细亮芯 + 中层 + 外层柔光，
--  都朝目标端收窄），但**整体比 csgo 细一半**（Scale = 0.5）。
--
--  触发源：游戏每次开枪都会上报
--      PlayerEvent:FireServer("bullet", { pos = <命中点>, posDestroyX = <X>, weaponName = <枪名> })
--  （dump 782961 / 792485 / 801991 / 811930 / 821611 / 831283 —— 六条武器分支都会发）
--  FL_AC 的 __namecall 已经拦着 PlayerEvent，这里只是挂一个 FL_AC.OnBullet 回调，
--  **没开弹道绘制时那个分支直接短路，全局钩子零额外成本**。
--
--  起点：优先找枪械模型上的枪口（Barrel / Muzzle 附件），
--        找不到就退到相机位置（第一人称下就是眼睛，视觉上同样对）。
--
--  整层塞进全局表 FL_TRACER，不新增顶层 local。
-- ===================================================================
do
	local RunService = game:GetService("RunService")
	local Players    = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer

	FL_TRACER = FL_TRACER or {}
	FL_TRACER.Enabled = false
	FL_TRACER.Hold    = 3        -- 停留（秒）
	FL_TRACER.Drift   = 1.2      -- 飘散（秒）
	FL_TRACER.Scale   = 0.5      -- 粗细系数（csgo 版是 1.0，这里细一半）
	FL_TRACER.MaxLive = 40       -- 同时存在的弹道上限
	FL_TRACER.Folder  = nil
	FL_TRACER.Count   = 0

	local MUZZLE_NAMES = { "Barrel", "Muzzle", "MuzzlePart", "MuzzleAttachment", "Tip" }

	local function folder()
		if FL_TRACER.Folder and FL_TRACER.Folder.Parent then
			return FL_TRACER.Folder
		end
		local f = workspace:FindFirstChild("FL_Tracers")
		if not f then
			f = Instance.new("Folder")
			f.Name = "FL_Tracers"
			f.Parent = workspace
		end
		FL_TRACER.Folder = f
		return f
	end

	-- 枪口：角色下带 Config 的武器模型 → 找 MUZZLE_NAMES 里的 BasePart 或 Attachment
	local function muzzlePos()
		local char = LocalPlayer.Character
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("ModuleScript") and d.Name == "Config" and d.Parent then
					for _, n in ipairs(MUZZLE_NAMES) do
						local m = d.Parent:FindFirstChild(n, true)
						if m then
							if m:IsA("BasePart") then return m.Position end
							if m:IsA("Attachment") then return m.WorldPosition end
						end
					end
				end
			end
		end
		local cam = workspace.CurrentCamera
		if cam then return cam.CFrame.Position end
		return nil
	end

	local function newPoint(parent, pos)
		local part = Instance.new("Part")
		part.Name = "TracerPoint"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery   = false     -- 🔴 必须：否则弹道会挡住自己的子弹和射线
		part.CanTouch   = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = Vector3.new(0.05, 0.05, 0.05)
		part.CFrame = CFrame.new(pos)
		part.Parent = parent
		local att = Instance.new("Attachment")
		att.Name = "TracerAttach"
		att.Parent = part
		return part, att
	end

	-- 三层叠加做「破空」：都朝目标端收窄（Width1 < Width0）。
	-- ⚠️ 数值 = csgo 版 × Scale（默认 0.5 → 细一半）。
	local function newBeam(parent, a0, a1, w0, w1, transparency, emission)
		local k = tonumber(FL_TRACER.Scale) or 0.5
		local beam = Instance.new("Beam")
		beam.Name = "TracerBeam"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = w0 * k
		beam.Width1 = w1 * k
		beam.Segments = 1
		beam.FaceCamera = true
		beam.LightEmission = emission
		beam.LightInfluence = 0      -- 不吃环境光 → 暗处也是纯白
		beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
		beam.Transparency = NumberSequence.new(transparency)
		beam.Parent = parent
		return beam
	end

	local function spawnTracer(from, to)
		if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then return end
		if (to - from).Magnitude < 2 then return end
		local f = folder()
		if not f then return end

		-- 并发上限：连射时不堆爆
		local kids = f:GetChildren()
		if #kids >= FL_TRACER.MaxLive then
			for i = 1, #kids - FL_TRACER.MaxLive + 1 do
				pcall(function() kids[i]:Destroy() end)
			end
		end

		local holder = Instance.new("Folder")
		holder.Name = "Tracer"
		holder.Parent = f
		FL_TRACER.Count = FL_TRACER.Count + 1

		local p0, a0 = newPoint(holder, from)
		local p1, a1 = newPoint(holder, to)

		local core = newBeam(holder, a0, a1, 0.20, 0.06, 0.00, 1.00)
		local mid  = newBeam(holder, a0, a1, 0.55, 0.20, 0.72, 0.80)
		local halo = newBeam(holder, a0, a1, 1.30, 0.45, 0.88, 0.45)
		local k = tonumber(FL_TRACER.Scale) or 0.5

		task.spawn(function()
			task.wait(math.max(0.1, tonumber(FL_TRACER.Hold) or 3))
			if not holder.Parent then return end

			local drift = math.max(0.1, tonumber(FL_TRACER.Drift) or 1.2)
			local up = Vector3.new(0, 1, 0)
			local t = 0
			while t < drift do
				local dt = RunService.Heartbeat:Wait()
				if not holder.Parent then return end
				t = t + dt
				local e = math.clamp(t / drift, 0, 1)
				e = e * e                    -- 越到后面散得越快
				core.Transparency = NumberSequence.new(e)
				mid.Transparency  = NumberSequence.new(0.72 + 0.28 * e)
				halo.Transparency = NumberSequence.new(0.88 + 0.12 * e)
				core.Width0 = 0.20 * k * (1 - 0.55 * e); core.Width1 = 0.06 * k * (1 - 0.55 * e)
				mid.Width0  = 0.55 * k * (1 + 2.6 * e);  mid.Width1  = 0.20 * k * (1 + 2.6 * e)
				halo.Width0 = 1.30 * k * (1 + 3.2 * e);  halo.Width1 = 0.45 * k * (1 + 3.2 * e)
				local shift = up * (1.4 * e)
				p0.CFrame = CFrame.new(from + shift)
				p1.CFrame = CFrame.new(to + shift * 1.8)
			end
			holder:Destroy()
		end)
	end
	FL_TRACER.Spawn = spawnTracer

	-- FL_AC 的 __namecall 会在收到 "bullet" 上报时调这里
	function FL_TRACER.OnBullet(payload)
		if not FL_TRACER.Enabled then return end
		if type(payload) ~= "table" then return end
		local to = payload.pos
		if typeof(to) ~= "Vector3" then return end
		local from = muzzlePos()
		if not from then return end
		pcall(spawnTracer, from, to)
	end

	function FL_TRACER.Set(on)
		FL_TRACER.Enabled = on and true or false
		if FL_TRACER.Enabled then
			folder()
			if FL_AC then FL_AC.OnBullet = FL_TRACER.OnBullet end
		else
			if FL_AC then FL_AC.OnBullet = nil end
			local f = FL_TRACER.Folder
			if f then
				for _, c in ipairs(f:GetChildren()) do
					pcall(function() c:Destroy() end)
				end
			end
		end
		return FL_TRACER.Enabled
	end

	function FL_TRACER.Status()
		return {
			Enabled  = FL_TRACER.Enabled,
			Hooked   = (FL_AC and FL_AC.OnBullet ~= nil) or false,
			Scale    = FL_TRACER.Scale,
			Hold     = FL_TRACER.Hold,
			Drift    = FL_TRACER.Drift,
			Live     = FL_TRACER.Folder and #FL_TRACER.Folder:GetChildren() or 0,
			Count    = FL_TRACER.Count,
		}
	end
end

-- ==================================================================
--  飞行 v3（CX_FLY）—— 走【游戏自己的平台通道】，服务端认可
--
--  ⭐⭐ 挖到底的结论（`ReplicatedStorage.Client.Wanted.Modules.ClientPlatforms`）：
--     这个游戏有"移动平台"系统 —— 平台 = CollectionService 标签 "Platform" 的部件。
--     客户端每帧（`stepPlatforms`）做三件事：
--        ① 射线找脚下最近的 Platform
--        ② Character:PivotTo(平台本帧位移 * Character.CFrame)          ← 本地移动角色
--        ③ 每 0.2s：FireServer("updatePlatformUnreliable", 平台, CompressCFrame(角色相对平台的偏移))
--           （离开平台时 FireServer("updatePlatform", nil)）
--
--     服务端把角色位置算成 **平台 CFrame × 上报的偏移** ⇒
--     **它信任客户端报的偏移** —— 而且这是游戏自己每秒 5 次都在发的包，完全不突兀。
--
--  ⇒ 所以：**先本地移动，再照游戏一模一样的方式上报偏移** = 服务端认可的位移。
--    这就是"别人能稳定飞"的原理：不是硬写 HRP（会被拉回），是**借用游戏自己的通道**。
--
--  ⚠️ 前提：附近要有 Platform 标签的部件（游戏里的移动平台 / 升降台）。
--     没有的话这条通道用不了，会退化成普通 CFrame 写（那就还是会被拉回）。
-- ==================================================================
do
	local Players    = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UIS        = game:GetService("UserInputService")
	local CollectionService = game:GetService("CollectionService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	local Camera      = workspace.CurrentCamera

	CX_FLY = CX_FLY or {}
	CX_FLY.Enabled       = false
	CX_FLY.Speed         = 60
	CX_FLY.VertSpeed     = 40
	CX_FLY.MaxStep       = 8      -- 单帧位移上限
	CX_FLY.ReportRate    = 0.2    -- 上报间隔（和游戏一致）
	CX_FLY.PlatformRange = 250    -- 找平台的范围
	CX_FLY.UsePlatform   = true   -- ⭐ 走平台通道（服务端认可）
	CX_FLY.Up            = false  -- UI 上升（手机用）
	CX_FLY.Down          = false  -- UI 下降（手机用）
	CX_FLY.Platform      = nil
	CX_FLY.Reports       = 0
	CX_FLY.Steps         = 0
	CX_FLY.LastErr       = nil
	CX_FLY._conn         = nil
	CX_FLY._lastReport   = 0

	-- 拿游戏自己的 MathUtil（压缩 CFrame 用；拿不到就发原始 CFrame）
	local MathUtil
	pcall(function()
		MathUtil = require(ReplicatedStorage.Devv).load("MathUtil")
	end)

	local function key(k)
		local ok, down = pcall(function() return UIS:IsKeyDown(k) end)
		return ok and down
	end

	-- ⭐ 方向读【游戏自己的 Humanoid.MoveDirection】——
	--    那是游戏的控制模块算出来的，**手机摇杆 / 手柄 / 键盘全都写进它**，
	--    所以这样写天然适配移动端，而且和游戏"一比一"（不是我们自己解析按键）。
	local function moveDir(hrp)
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return nil end
		local md = hum.MoveDirection
		if not md or md.Magnitude <= 0.01 then return nil end
		-- MoveDirection 是相机空间的，转成世界方向（游戏也是这么用的）
		local cf = Camera and Camera.CFrame
		if not cf then return md end
		local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
		if look.Magnitude < 1e-4 then look = Vector3.new(0, 0, -1) end
		if right.Magnitude < 1e-4 then right = Vector3.new(1, 0, 0) end
		look, right = look.Unit, right.Unit
		return (look * -md.Z + right * md.X)
	end

	-- 找附近带 "Platform" 标签的部件
	function CX_FLY.FindPlatform()
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil end
		local best, bestD = nil, CX_FLY.PlatformRange
		pcall(function()
			for _, p in ipairs(CollectionService:GetTagged("Platform")) do
				if p and p.Parent and p:IsA("BasePart") then
					local d = (p.Position - hrp.Position).Magnitude
					if d < bestD then best, bestD = p, d end
				end
			end
		end)
		return best
	end

	function CX_FLY.Step(dt)
		dt = tonumber(dt) or (1 / 60)
		local char = LocalPlayer.Character
		if not char then CX_FLY.LastErr = "没有角色" return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then CX_FLY.LastErr = "没有 HRP" return end

		local dir = moveDir(hrp)
		local vertical = 0
		-- 上升/下降：优先 UI 开关（手机可用），键盘 Space/Ctrl 作为补充
		if CX_FLY.Up then vertical = vertical + 1 end
		if CX_FLY.Down then vertical = vertical - 1 end
		if key(Enum.KeyCode.Space) then vertical = vertical + 1 end
		if key(Enum.KeyCode.LeftControl) or key(Enum.KeyCode.LeftShift) then vertical = vertical - 1 end

		local step = Vector3.new(0, 0, 0)
		if dir and dir.Magnitude > 0 then
			step = step + dir.Unit * (CX_FLY.Speed * dt)
		end
		step = step + Vector3.new(0, vertical * (CX_FLY.VertSpeed * dt), 0)
		if step.Magnitude > CX_FLY.MaxStep then
			step = step.Unit * CX_FLY.MaxStep
		end
		if step.Magnitude <= 1e-6 then return end

		-- ① 本地移动（保留朝向，和游戏一样）
		local ok = pcall(function() hrp.CFrame = hrp.CFrame + step end)
		if not ok then CX_FLY.LastErr = "写 CFrame 失败" return end
		CX_FLY.Steps = CX_FLY.Steps + 1

		-- ② 照游戏的方式上报偏移（服务端据此认下这个位置）
		if not CX_FLY.UsePlatform then return end
		local plat = CX_FLY.Platform
		if not (plat and plat.Parent) then
			plat = CX_FLY.FindPlatform()
			CX_FLY.Platform = plat
		end
		if not plat then
			CX_FLY.LastErr = "附近没有 Platform 标签的部件（这条通道用不了）"
			return
		end

		local now = os.clock()
		if now - CX_FLY._lastReport < CX_FLY.ReportRate then return end
		CX_FLY._lastReport = now

		local net = CX_META and CX_META.Network
		if not (net and type(net.FireServer) == "function") then
			CX_FLY.LastErr = "Network 未挂上"
			return
		end

		local offset = plat:GetPivot():ToObjectSpace(hrp.CFrame)
		local payload = offset
		if MathUtil and type(MathUtil.CompressCFrame) == "function" then
			local okc, c = pcall(MathUtil.CompressCFrame, offset)
			if okc and c then payload = c end
		end
		net.FireServer("updatePlatformUnreliable", plat, payload)
		CX_FLY.Reports = CX_FLY.Reports + 1
		CX_FLY.LastErr = nil
	end

	function CX_FLY.Set(on)
		CX_FLY.Enabled = on and true or false
		if CX_FLY._conn then
			CX_FLY._conn:Disconnect()
			CX_FLY._conn = nil
		end
		if not CX_FLY.Enabled then
			-- 退出时照游戏的做法清一次
			pcall(function()
				local net = CX_META and CX_META.Network
				if net and type(net.FireServer) == "function" then
					net.FireServer("updatePlatform", nil)
				end
			end)
			CX_FLY.Platform = nil
			return
		end
		CX_FLY._conn = RunService.RenderStepped:Connect(function(dt)
			if CX_FLY.Enabled then
				pcall(CX_FLY.Step, dt)
			end
		end)
	end

	function CX_FLY.Status()
		return string.format("飞行=%s 平台通道=%s 平台=%s | 位移=%d 上报=%d\n方向读 Humanoid.MoveDirection（手机/手柄/键盘通用） | %s",
			tostring(CX_FLY.Enabled), tostring(CX_FLY.UsePlatform),
			tostring(CX_FLY.Platform and CX_FLY.Platform.Name or "无"),
			CX_FLY.Steps, CX_FLY.Reports, tostring(CX_FLY.LastErr or "ok"))
	end
end

