    local function findNearestProp()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local root = Workspace:FindFirstChild("Local")
        if not root then return nil end
        local best, bestD, seen = nil, propRadius, 0
        for _, d in ipairs(root:GetDescendants()) do
            seen = seen + 1
            if seen > 40000 then break end
            local ok, id = pcall(function() return d:GetAttribute("objectId") end)
            if ok and type(id) == "string" then
                local ok2, pos = pcall(function()
                    if d.PrimaryPart then return d.PrimaryPart.Position end
                    if d:IsA("BasePart") then return d.Position end
                    return nil
                end)
                if ok2 and pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < bestD then best, bestD = id, dist end
                end
            end
        end
        return best, bestD
    end

