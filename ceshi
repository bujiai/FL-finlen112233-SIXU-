CX_META = CX_META or {}
CX_META.Enabled = true
CX_META.Silent = true          
CX_META.UseMetaHooks = false   
CX_META.Dropped = 0
CX_META.Blocked = {
	fling = true, resetVelocity = true, spectatePlayer = true,
	reconnectPlayer = true, resetCharacter = true,
}
CX_META.GuardSpeed = true
CX_META.GuardVelocity = true
CX_META.Network = nil
CX_META._nc = nil
CX_META._ni = nil
local _A = {
	getrawmetatable   = getrawmetatable,
	setreadonly       = setreadonly,
	getnamecallmethod = getnamecallmethod,
	hookmetamethod    = hookmetamethod,
}
local function _drop(name)
	if CX_META.Enabled and type(name) == "string" and CX_META.Blocked[name] then
		CX_META.Dropped = CX_META.Dropped + 1
		return true
	end
	return false
end
function CX_META.Install()
	pcall(function()
		local net = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared")
			:WaitForChild("Core"):WaitForChild("Network"))
		if type(net) == "table" then
			CX_META.Network = net
			local oldFire = net.FireServer
			if type(oldFire) == "function" then
				net.FireServer = function(name, ...)
					if _drop(name) then return nil end
					return oldFire(name, ...)
				end
			end
			local oldInvoke = net.InvokeServer
			if type(oldInvoke) == "function" then
				net.InvokeServer = function(name, ...)
					if _drop(name) then return nil end
					return oldInvoke(name, ...)
				end
			end
		end
	end)
	if not CX_META.UseMetaHooks then return CX_META.Network ~= nil end
	local ok, mt = pcall(_A.getrawmetatable, game)
	if not ok or type(mt) ~= "table" then return CX_META.Network ~= nil end
	local oldNC = rawget(mt, "__namecall")
	local oldNI = rawget(mt, "__newindex")
	pcall(_A.setreadonly, mt, false)
	if type(oldNC) == "function" and not CX_META._nc then
		CX_META._nc = function(self, ...)
			if CX_META.Enabled and _A.getnamecallmethod() == "FireServer" then
				if _drop(select(1, ...)) then return nil end
			end
			return oldNC(self, ...)
		end
		pcall(function() mt.__namecall = CX_META._nc end)
	end
	if type(oldNI) == "function" and not CX_META._ni then
		CX_META._ni = function(self, key, value)
			if CX_META.Enabled then
				local okI, isInst = pcall(function() return typeof(self) == "Instance" end)
				if okI and isInst then
					if CX_META.GuardSpeed and key == "WalkSpeed" then
						local okH, isHum = pcall(function() return self:IsA("Humanoid") end)
						if okH and isHum then return nil end
					end
					if CX_META.GuardVelocity and (key == "AssemblyLinearVelocity"
						or key == "AssemblyAngularVelocity") then
						local okP, isPart = pcall(function() return self:IsA("BasePart") end)
						if okP and isPart then return nil end
					end
				end
			end
			return oldNI(self, key, value)
		end
		pcall(function() mt.__newindex = CX_META._ni end)
	end
	pcall(_A.setreadonly, mt, true)
	if not CX_META._nc and type(_A.hookmetamethod) == "function" then
		pcall(function()
			local old = _A.hookmetamethod(game, "__namecall", function(self, ...)
				if _drop(select(1, ...)) then return nil end
				return old(self, ...)
			end)
			CX_META._nc = true
		end)
	end
	return true
end
pcall(CX_META.Install)
CX_STATE = CX_STATE or {}
CX_STATE.Enabled = true         
CX_STATE.ForceSprint = true      
CX_STATE.Log = {}                
CX_STATE.Forged = 0
CX_STATE._hooked = false
CX_STATE.Pin = {
	sprinting = true,
	walking = false,
	isRunning = true,
	ragdolled = false,
	crouching = false,
}
function CX_STATE.Install()
	if CX_STATE._hooked then return true end
	local ok, net = pcall(function()
		return require(game:GetService("ReplicatedStorage"):WaitForChild("Shared")
			:WaitForChild("Core"):WaitForChild("Network"))
	end)
	if not ok or type(net) ~= "table" or type(net.FireServer) ~= "function" then
		return false
	end
	local prev = net.FireServer
	net.FireServer = function(name, key, value, ...)
		if CX_STATE.Enabled and name == "replicatePlayerProperty" and type(key) == "string" then
			CX_STATE.Log[key] = (CX_STATE.Log[key] or 0) + 1
			local pin = CX_STATE.Pin[key]
			if pin ~= nil then
				CX_STATE.Forged = CX_STATE.Forged + 1
				return prev(name, key, pin, ...)
			end
		end
		return prev(name, key, value, ...)
	end
	CX_STATE._hooked = true
	return true
end
function CX_STATE.Report()
	local list = {}
	for k, v in pairs(CX_STATE.Log) do list[#list + 1] = k .. "×" .. v end
	table.sort(list)
	return string.format("伪造 %d 次 | 见过的状态属性: %s",
		CX_STATE.Forged, #list > 0 and table.concat(list, " ") or "（还没有）")
end
pcall(CX_STATE.Install)
CX_CRACK = CX_CRACK or {}
CX_CRACK.Radius   = 60        
CX_CRACK.Interval = 0.35      
CX_CRACK.Done     = 0
CX_CRACK.Failed   = 0
CX_CRACK.LastErr  = nil
CX_CRACK._busy    = false
local GIZMO_VERB = {
	Safe = "OpenSafe", GasStationSafe = "OpenSafe", QuestSafe = "OpenSafe",
	Suitcase = "open", ShippingCrate = "open", MilitaryChest = "Open",
	PelicanCase = "GetTool", Briefcase = "open",
}
local PROP_VERB = {
	LockedMilitaryCrate = "hack", JewelryVaultDoor = "dismantle",
	VaultDoor = "toggle", Door = "toggle", DestructibleGarage = "toggle",
}
local function fire(name, ...)
	local net = CX_META and CX_META.Network
	if net and type(net.FireServer) == "function" then
		net.FireServer(name, ...)
		return true
	end
	return false
end
function CX_CRACK.Collect()
	local out = {}
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return out end
	local root = workspace:FindFirstChild("Local")
	if not root then return out end
	local seen = 0
	for _, d in ipairs(root:GetDescendants()) do
		seen = seen + 1
		if seen > 200000 then break end
		local ok, id = pcall(function() return d:GetAttribute("objectId") end)
		if ok and type(id) == "string" then
			local ok2, gt = pcall(function() return d:GetAttribute("gizmoType") end)
			local ok3, pos = pcall(function()
				if d.PrimaryPart then return d.PrimaryPart.Position end
				if d:IsA("BasePart") then return d.Position end
				return nil
			end)
			if ok3 and pos then
				local dist = (pos - hrp.Position).Magnitude
				if dist <= CX_CRACK.Radius then
					out[#out + 1] = {
						id = id,
						gizmoType = ok2 and type(gt) == "string" and gt or nil,
						class = d.ClassName,
						dist = dist,
					}
				end
			end
		end
	end
	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end
function CX_CRACK.VerbFor(t)
	if t.gizmoType then
		for k, v in pairs(GIZMO_VERB) do
			if string.find(t.gizmoType, k, 1, true) then return "gizmoInteraction", v end
		end
	end
	for k, v in pairs(PROP_VERB) do
		if t.class == k then return "propInteraction", v end
	end
	return nil, nil
end
function CX_CRACK.RunAll()
	if CX_CRACK._busy then return 0 end
	CX_CRACK._busy = true
	local targets = CX_CRACK.Collect()
	local n = 0
	for _, t in ipairs(targets) do
		local verb, action = CX_CRACK.VerbFor(t)
		if verb then
			if fire(verb, t.id, action) then
				CX_CRACK.Done = CX_CRACK.Done + 1
				n = n + 1
			else
				CX_CRACK.Failed = CX_CRACK.Failed + 1
				CX_CRACK.LastErr = "Network 未挂上"
			end
			task.wait(CX_CRACK.Interval)
		end
	end
	CX_CRACK._busy = false
	return n
end
	function CX_CRACK.InstallKeypadHook()
		local ok, Keypad = pcall(function()
			return require(game:GetService("ReplicatedStorage").Devv).load("KeypadScreen")
		end)
		if not ok or type(Keypad) ~= "table" or type(Keypad.StartKeypadSequence) ~= "function" then
			return false
		end
		if CX_CRACK._keypadHooked then return true end
		local prev = Keypad.StartKeypadSequence
		Keypad.StartKeypadSequence = function(self, opts)
			local r = prev(self, opts)
			if CX_CRACK.AutoKeypad and type(opts) == "table"
				and type(opts.successFunc) == "function" then
				task.delay(0.05, function()
					pcall(opts.successFunc)
					CX_CRACK.Done = CX_CRACK.Done + 1
				end)
			end
			return r
		end
		CX_CRACK._keypadHooked = true
		return true
	end
	pcall(CX_CRACK.InstallKeypadHook)
	function CX_CRACK.SetAuto(on)
		CX_CRACK.AutoLoop = on and true or false
		if CX_CRACK._autoConn then
			pcall(function() CX_CRACK._autoConn:Disconnect() end)
			CX_CRACK._autoConn = nil
		end
		if not CX_CRACK.AutoLoop then return end
		CX_CRACK._autoConn = game:GetService("RunService").Heartbeat:Connect(function()
			if not CX_CRACK.AutoLoop then return end
			local now = os.clock()
			if now - (CX_CRACK._autoLast or 0) < 2 then return end
			CX_CRACK._autoLast = now
			pcall(CX_CRACK.RunAll)
		end)
	end
	function CX_CRACK.Status()
	return string.format("已破解 %d 个 / 失败 %d | 半径 %.0f | %s",
		CX_CRACK.Done, CX_CRACK.Failed, CX_CRACK.Radius,
		tostring(CX_CRACK.LastErr or "ok"))
end
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local LocalPlayer = Players.LocalPlayer
	CX_RAGE = CX_RAGE or {}
	CX_RAGE.Enabled    = false
	CX_RAGE.Range      = 300      
	CX_RAGE.Interval   = 0.1      
	CX_RAGE.MaxTargets = 8        
	CX_RAGE.Part       = "Head"   
	CX_RAGE.TrackMode  = "最近"   
	CX_RAGE.FOV        = 300       
	CX_RAGE.FovOnly    = true      
	CX_RAGE.DrawLine   = true      
	CX_RAGE._lineGui   = nil
	CX_RAGE._lines     = {}
	CX_RAGE.TeamCheck  = false    
	CX_RAGE.OnlyCombat = false    
	CX_RAGE.Tracer     = true     
	CX_RAGE.Shots      = 0
	CX_RAGE.Kills      = 0
	CX_RAGE.LastErr    = nil
	CX_RAGE._conn      = nil
	CX_RAGE._reloading = false
	local Devv, Network, MathUtil, NUID, ClientTools, EquippedScreen
	pcall(function()
		Devv = require(ReplicatedStorage.Devv)
		Network       = Devv.load("Network")
		MathUtil      = Devv.load("MathUtil")
		NUID          = Devv.load("NUID")
		ClientTools   = Devv.load("ClientTools")
		EquippedScreen= Devv.load("EquippedScreen")
	end)
	local function nuid()
		if NUID then
			local ok, id = pcall(NUID)
			if ok and id then return id end
		end
		local r = Random.new()
		local t = ""
		for _ = 1, 8 do t = t .. tostring(r:NextInteger(0, 9)) end
		return t
	end
	local function compress(cf)
		if MathUtil and type(MathUtil.CompressCFrame) == "function" then
			local ok, c = pcall(MathUtil.CompressCFrame, cf)
			if ok and c then return c end
		end
		return cf
	end
	local function setAmmo(tool)
		if not (EquippedScreen and tool and tool.toolState) then return end
		pcall(function()
			EquippedScreen:SetAmmo(tool.toolState.ammo, tool.toolState.totalAmmo,
				tool.toolState.isInfinite or false)
		end)
	end
	local function reload(tool)
		if CX_RAGE._reloading then return end
		CX_RAGE._reloading = true
		pcall(function()
			Network.FireServer("reload", tool:GetId())
			task.delay(2.5, function()
				if tool.ammoData and tool.toolState then
					tool.toolState.ammo = tool.ammoData.magSize or 15
					setAmmo(tool)
				end
				CX_RAGE._reloading = false
			end)
		end)
	end
	function CX_RAGE.Targets()
		local out = {}
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return out end
		local myTeam = LocalPlayer.Team
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local c = p.Character
				local t = c and (c:FindFirstChild(CX_RAGE.Part) or c:FindFirstChild("HumanoidRootPart"))
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if c and t and h and h.Health > 0 then
					local ok = true
					if CX_RAGE.TeamCheck and myTeam and p.Team == myTeam then ok = false end
					if ok and CX_RAGE.OnlyCombat then
						local cm = p:GetAttribute("CombatMode")
						if cm ~= true then ok = false end
					end
					if ok then
						local d = (hrp.Position - t.Position).Magnitude
						if CX_RAGE.FovOnly then
							local cam = workspace.CurrentCamera
							if cam then
								local sp, on = cam:WorldToViewportPoint(t.Position)
								if on then
									local scale = cam.ViewportSize.Y / 1080
									local mid = cam.ViewportSize * 0.5
									local px = (Vector2.new(sp.X, sp.Y) - mid).Magnitude
									if px > CX_RAGE.FOV * scale then ok = false end
								else
									ok = false
								end
							end
						end
						if ok and d <= CX_RAGE.Range then
							out[#out + 1] = { player = p, part = t, dist = d, hum = h }
						end
					end
				end
			end
		end
		table.sort(out, function(a, b) return a.dist < b.dist end)
		return out
	end
	function CX_RAGE.Hit(tool, target)
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (hrp and target.part) then return false end
		local muzzle = hrp.Position + Vector3.new(0, 2, 0)
		local hitPos = target.part.Position
		local dir = (hitPos - muzzle).Unit
		local id = nuid()
		local cf = compress(CFrame.lookAlong(muzzle, dir))
		if tool.toolState then
			tool.toolState.ammo = math.max(0, (tool.toolState.ammo or 0) - 1)
			setAmmo(tool)
		end
		Network.InvokeServer("shoot", tool:GetId(), cf, { { id, cf } })
		Network.FireServer("registerProjectileHits", id, tool:GetId(), {
			{
				normal = -dir, direction = dir,
				hitName = CX_RAGE.Part,
				source = "Bullet",
				userId = target.player.UserId,
				massLimit = 5,
				ownerId = LocalPlayer.UserId,
				position = hitPos,
				processedPlayerId = LocalPlayer.UserId,
				hit = target.part,
				speed = (tool.projectile and tool.projectile.muzzleVelocity) or 300,
				collisionPoint = hitPos,
				material = Enum.Material.Plastic,
				hitType = "player",
			}
		})
		CX_RAGE.Shots = CX_RAGE.Shots + 1
		if CX_RAGE.Tracer and FL_TRACER and FL_TRACER.Spawn then
			pcall(FL_TRACER.Spawn, muzzle, hitPos)
		end
		return true
	end
	function CX_RAGE.Step()
		if not CX_RAGE.Enabled then return end
		local tool = ClientTools and ClientTools.GetLocalEquippedTool
			and ClientTools.GetLocalEquippedTool()
		if not tool or type(tool.GetId) ~= "function" or not tool.toolState then
			CX_RAGE.LastErr = "手上没有武器"
			return
		end
		if (tool.toolState.ammo or 0) <= 0 then
			reload(tool)
			return
		end
		local targets = CX_RAGE.Targets()
		if #targets == 0 then
			CX_RAGE.LastErr = "范围内没有目标"
			return
		end
		if CX_RAGE.TrackMode == "屏幕中心" or CX_RAGE.TrackMode == "准星方向" then
			local cam = workspace.CurrentCamera
			if cam then
				local mid = cam.ViewportSize * 0.5
				local scored = {}
				for _, t in ipairs(targets) do
					local sp, on = cam:WorldToViewportPoint(t.part.Position)
					if on then
						local d = CX_RAGE.TrackMode == "屏幕中心"
							and (Vector2.new(sp.X, sp.Y) - mid).Magnitude
							or (1 - cam.CFrame.LookVector:Dot((t.part.Position - cam.CFrame.Position).Unit))
						scored[#scored + 1] = { t = t, s = d }
					end
				end
				table.sort(scored, function(a, b) return a.s < b.s end)
				targets = {}
				for _, x in ipairs(scored) do targets[#targets + 1] = x.t end
			end
		end
		local n = 0
		for _, t in ipairs(targets) do
			if n >= CX_RAGE.MaxTargets then break end
			if (tool.toolState.ammo or 0) <= 0 then break end
			if pcall(CX_RAGE.Hit, tool, t) then
				n = n + 1
				CX_RAGE.LastErr = nil
			end
			task.wait(0.03)
		end
	end
	function CX_RAGE.Set(on)
		CX_RAGE.Enabled = on and true or false
		if CX_RAGE._conn then
			CX_RAGE._conn:Disconnect()
			CX_RAGE._conn = nil
		end
		if not CX_RAGE.Enabled then
			for _, ln in ipairs(CX_RAGE._lines) do pcall(function() ln.Visible = false end) end
			return
		end
		CX_RAGE._conn = RunService.Heartbeat:Connect(function()
			if not CX_RAGE.Enabled then return end
			local now = os.clock()
			if now - (CX_RAGE._last or 0) < CX_RAGE.Interval then return end
			CX_RAGE._last = now
			pcall(CX_RAGE.Step)
			if CX_RAGE.DrawLine then pcall(CX_RAGE.DrawLines) end
		end)
	end
	function CX_RAGE.EnsureLines()
		if CX_RAGE._lineGui then return end
		local plr = game:GetService("Players").LocalPlayer
		local pg = plr:FindFirstChild("PlayerGui")
		if not pg then return end
		local sg = Instance.new("ScreenGui")
		sg.Name = "CX_TrackLines"
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.Parent = pg
		CX_RAGE._lineGui = sg
	end
	function CX_RAGE.DrawLines()
		if not CX_RAGE.DrawLine then return end
		CX_RAGE.EnsureLines()
		local sg = CX_RAGE._lineGui
		if not sg then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local mid = cam.ViewportSize * 0.5
		local targets = CX_RAGE.Targets()
		for i, t in ipairs(targets) do
			local sp, on = cam:WorldToViewportPoint(t.part.Position)
			local ln = CX_RAGE._lines[i]
			if not ln then
				ln = Instance.new("Frame")
				ln.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
				ln.BorderSizePixel = 0
				ln.AnchorPoint = Vector2.new(0, 0.5)
				ln.ZIndex = 5
				ln.Parent = sg
				CX_RAGE._lines[i] = ln
			end
			if on then
				local a = Vector2.new(mid.X, mid.Y)
				local b = Vector2.new(sp.X, sp.Y)
				local delta = b - a
				ln.Position = UDim2.fromOffset(a.X, a.Y)
				ln.Size = UDim2.fromOffset(delta.Magnitude, 1)
				ln.Rotation = math.deg(math.atan2(delta.Y, delta.X))
				ln.Visible = true
			else
				ln.Visible = false
			end
		end
		for i = #targets + 1, #CX_RAGE._lines do
			CX_RAGE._lines[i].Visible = false
		end
	end
		function CX_RAGE.Status()
		return string.format("RageBot=%s 范围=%.0f 部位=%s | 开火 %d | 目标 %d | %s",
			tostring(CX_RAGE.Enabled), CX_RAGE.Range, CX_RAGE.Part,
			CX_RAGE.Shots, #CX_RAGE.Targets(), tostring(CX_RAGE.LastErr or "ok"))
	end
end
do
	local RunService = game:GetService("RunService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	CX_WPN = CX_WPN or {}
	CX_WPN.InfiniteAmmo = false
	CX_WPN.InstantReload = true
	CX_WPN.TopUpRate = 0.1     
	CX_WPN.Filled = 0
	CX_WPN.LastErr = nil
	CX_WPN._conn = nil
	CX_WPN._last = 0
	local Devv, Network, ClientTools, EquippedScreen
	pcall(function()
		Devv = require(ReplicatedStorage.Devv)
		Network       = Devv.load("Network")
		ClientTools   = Devv.load("ClientTools")
		EquippedScreen= Devv.load("EquippedScreen")
	end)
	local function equipped()
		if ClientTools and ClientTools.GetLocalEquippedTool then
			local ok, t = pcall(ClientTools.GetLocalEquippedTool)
			if ok then return t end
		end
		return nil
	end
	function CX_WPN.Fill(tool)
		local st = tool and tool.toolState
		if not st then return false end
		local mag = (tool.ammoData and tool.ammoData.magSize) or 30
		st.ammo = mag
		st.totalAmmo = -1
		st.isInfinite = true
		if EquippedScreen and EquippedScreen.SetAmmo then
			pcall(function() EquippedScreen:SetAmmo(mag, -1, true) end)
		end
		CX_WPN.Filled = CX_WPN.Filled + 1
		return true
	end
	function CX_WPN.Reload()
		local tool = equipped()
		if not tool or type(tool.GetId) ~= "function" then return false end
		if not (Network and Network.FireServer) then return false end
		pcall(function()
			Network.FireServer("reload", tool:GetId())
			Network.FireServer("chamber", tool:GetId())
		end)
		if CX_WPN.InfiniteAmmo then pcall(CX_WPN.Fill, tool) end
		return true
	end
	function CX_WPN.Step()
		local tool = equipped()
		if not tool or not tool.toolState then
			CX_WPN.LastErr = "手上没有武器"
			return
		end
		if CX_WPN.InfiniteAmmo then
			pcall(CX_WPN.Fill, tool)
		end
		if CX_WPN.InstantReload and (tool.toolState.ammo or 0) <= 0 then
			pcall(CX_WPN.Reload)
		end
		CX_WPN.LastErr = nil
	end
	function CX_WPN.Set(on)
		CX_WPN.InfiniteAmmo = on and true or false
		if CX_WPN._conn then
			CX_WPN._conn:Disconnect()
			CX_WPN._conn = nil
		end
		if not CX_WPN.InfiniteAmmo then return end
		CX_WPN._conn = RunService.Heartbeat:Connect(function()
