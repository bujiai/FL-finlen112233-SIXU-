local function initDevvModules()
    if not Devv then return false end
    local ok = pcall(function()
        local loaded = require(Devv)
        Network = loaded.GetModule and loaded.GetModule("Network") or loaded.load("Network")
        MathUtil = loaded.load("MathUtil")
        NUID = loaded.load("NUID")
        ClientTools = loaded.load("ClientTools")
        EquippedScreen = loaded.load("EquippedScreen")
    end)
    if not ok or not Network or not MathUtil or not ClientTools then
        pcall(function()
            local loaded = require(Devv)
            if loaded.load then
                Network = Network or loaded.load("Network")
                MathUtil = MathUtil or loaded.load("MathUtil")
                NUID = NUID or loaded.load("NUID")
                ClientTools = ClientTools or loaded.load("ClientTools")
                EquippedScreen = EquippedScreen or loaded.load("EquippedScreen")
            end
        end)
    end
    return Network ~= nil
end

local devvReady = initDevvModules()

local function getLocalEquippedTool()
    if ClientTools and ClientTools.GetLocalEquippedTool then
        return ClientTools.GetLocalEquippedTool()
    end
    return nil
end

local function generateProjectileId()
    if NUID then
        local ok, id = pcall(NUID)
        if ok then return id end
    end
    local r = Random.new()
    local s = ""
    for _ = 1, 8 do s = s .. tostring(r:NextInteger(0, 9)) end
    return s
end

local function compressCFrame(cframe)
    if MathUtil and MathUtil.CompressCFrame then
        local ok, result = pcall(MathUtil.CompressCFrame, cframe)
        if ok then return result end
    end
    return cframe
end

local function fireServer(remoteName, ...)
    if Network and Network.FireServer then
        Network.FireServer(remoteName, ...)
    end
end

local function updateAmmoDisplay(tool)
    if EquippedScreen and tool and tool.toolState then
        EquippedScreen:SetAmmo(tool.toolState.ammo, tool.toolState.totalAmmo, tool.toolState.isInfinite or false)
    end
end

local isReloading = false
local function autoReload(tool)
    if isReloading then return end
    isReloading = true
    fireServer("reload", tool:GetId())
    task.delay(2.5, function()
        if tool.ammoData and tool.toolState then
            tool.toolState.ammo = tool.ammoData.magSize or 15
            updateAmmoDisplay(tool)
        end
        isReloading = false
    end)
end

local function isPlayerAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getTargetPart(char)
    return char:FindFirstChild(CFG.targetPart) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function getClosestPlayerToFoV()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, closestDist = nil, CFG.aimbotFOV
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isPlayerAlive(player) then
            local char = player.Character
            local part = getTargetPart(char)
            if part then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function getClosestPlayerByDistance()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChild("Humanoid")
            if targetRoot and targetHum and targetHum.Health > 0 then
                local dist = (myRoot.Position - targetRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

local function getTeamInfo(player)
    local team = player:GetAttribute("currentTeam")
    local stars = player:GetAttribute("stars") or 0
    local isPolice = team == "police"
    local isSyndicate = team == "syndicate"
    local isCriminal = not isPolice and not isSyndicate
    local teamName = isPolice and "POLICE" or (isSyndicate and "SYNDICATE" or "CRIMINAL")
    local teamColor = isPolice and Color3.fromRGB(80, 130, 255) or (isSyndicate and Color3.fromRGB(180, 80, 255) or Color3.fromRGB(255, 100, 100))
    return {team = team, isPolice = isPolice, isSyndicate = isSyndicate, isCriminal = isCriminal, teamName = teamName, teamColor = teamColor, stars = stars}
end

local function isPVP(myInfo, targetInfo)
    if myInfo.isCriminal then return true end
    if myInfo.isPolice and (targetInfo.isCriminal or targetInfo.isSyndicate) then return true end
    if myInfo.isSyndicate and targetInfo.isPolice then return true end
    return false
end

local function getHealthInfo(player)
    local char = player.Character
    if not char then return 0, 1, false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return 0, 1, false end
    local health = hum.Health
    local knocked = health <= BASE_KNOCKED_HEALTH
    local displayHealth = knocked and health or (health - BASE_KNOCKED_HEALTH)
    local displayMax = knocked and BASE_KNOCKED_HEALTH or BASE_CHARACTER_HEALTH
    return displayHealth, math.clamp(displayHealth / displayMax, 0, 1), knocked
end

local currentTarget = nil
local bulletTracers = {}

local function spawnBulletTracer(fromPos, toPos)
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(255, 255, 100)
    part.Transparency = 0.3
    part.Size = Vector3.new(0.15, 0.15, (toPos - fromPos).Magnitude)
    part.CFrame = CFrame.lookAt(fromPos, toPos) * CFrame.new(0, 0, -(toPos - fromPos).Magnitude / 2)
    part.Parent = Workspace
    local conn
    conn = RunService.Heartbeat:Connect(function()
        part.Transparency = part.Transparency + 0.05
        if part.Transparency >= 1 then
            part:Destroy()
            conn:Disconnect()
        end
    end)
end

local ragebotTarget = nil
local function updateRagebot()
    if not CFG.ragebot or isReloading then return end
    local tool = getLocalEquippedTool()
    if not tool or type(tool.GetId) ~= "function" or not tool.toolState then return end
    if tool.toolState.ammo <= 0 then
        if CFG.autoReload then autoReload(tool) end
        return
    end
    local target = getClosestPlayerByDistance()
    ragebotTarget = target
    if not target then return end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetHead = target.Character:FindFirstChild("Head")
    if not myRoot or not targetHead then return end

    tool.toolState.ammo = tool.toolState.ammo - 1
    updateAmmoDisplay(tool)

    local toolId = tool:GetId()
    local muzzleVel = tool.projectile and tool.projectile.muzzleVelocity
    local origin = myRoot.Position + Vector3.new(0, 2, 0)
    local targetPos = targetHead.Position
    local direction = (targetPos - origin).Unit
    local projectileId = NUID and NUID() or generateProjectileId()
    local compressed = MathUtil and MathUtil.CompressCFrame and MathUtil.CompressCFrame(CFrame.lookAlong(origin, direction)) or compressCFrame(CFrame.lookAlong(origin, direction))

    fireServer("shoot", toolId, compressed, {{projectileId, compressed}})

    if CFG.bulletTrace then
        spawnBulletTracer(origin, targetPos)
    end

    fireServer("registerProjectileHits", projectileId, toolId, {
        {
            normal = -direction,
            direction = direction,
            hitName = "Head",
            source = "Bullet",
            userId = target.UserId,
            massLimit = 5,
            ownerId = LocalPlayer.UserId,
            position = targetPos,
            processedPlayerId = LocalPlayer.UserId,
            hit = targetHead,
            speed = muzzleVel,
            collisionPoint = targetPos,
            material = Enum.Material.Plastic,
            hitType = "player",
        }
    })
end

local function updateAimbot()
    if not CFG.aimbot then
        currentTarget = nil
        return nil
    end
    local target = getClosestPlayerToFoV()
    currentTarget = target
    if target and target.Character then
        local part = getTargetPart(target.Character)
        if part then
            local targetPos = part.Position
            local currentLook = Camera.CFrame.LookVector
            local toTarget = (targetPos - Camera.CFrame.Position).Unit
            local newLook = currentLook:Lerp(toTarget, 0.35)
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + newLook)
        end
    end
    return target
end

