	CX_FLY = CX_FLY or {}
	CX_FLY.Enabled     = true
	CX_FLY.Speed       = 95
	CX_FLY.VertSpeed   = 30
	CX_FLY.FreezeAnim  = true
	CX_FLY.Pullbacks   = 0
	CX_FLY.Steps       = 0
	CX_FLY.LastErr     = nil
	CX_FLY._conn       = nil
	CX_FLY._lastTarget = nil

	local function parts()
		local c = LocalPlayer.Character
		if not (c and c.Parent) then return nil end
		local hum = c:FindFirstChildWhichIsA("Humanoid")
		local root = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
		if not (hum and root) then return nil end
		return c, hum, root
	end

	local function freezeAnim(char, frozen)
		local anim = char:FindFirstChild("Animate")
		if anim then pcall(function() anim.Disabled = frozen end) end
		pcall(function()
			local h = char:FindFirstChildOfClass("Humanoid")
				or char:FindFirstChildOfClass("AnimationController")
			if not h then return end
			for _, t in next, h:GetPlayingAnimationTracks() do
				pcall(function() t:AdjustSpeed(frozen and 0 or 1) end)
			end
		end)
	end

	local function moveDir(hum)
		local md = hum.MoveDirection
		if not md or md.Magnitude <= 0.01 then return Vector3.zero end
		return md
	end

	local function vertical()
		local v = 0
		if CX_FLY.Up then v = v + 1 end
		if CX_FLY.Down then v = v - 1 end
		pcall(function()
			if UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + 1 end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
				v = v - 1
			end
		end)
		return v
	end

	function CX_FLY.Start()
		local char, hum = parts()
		if not char or not hum then return false end
		if CX_FLY.FreezeAnim then freezeAnim(char, true) end
		return true
	end

	function CX_FLY.Step(dt)
		if not CX_FLY.Enabled then return end
		local char, hum, root = parts()
		if not char or not hum or not root then return end

		if CX_FLY._lastTarget then
			local drift = (root.Position - CX_FLY._lastTarget).Magnitude
			if drift > math.max(6, CX_FLY.Speed * dt * 4) then
				CX_FLY.Pullbacks = CX_FLY.Pullbacks + 1
			end
		end

		local dir = moveDir(hum) * CX_FLY.Speed
		local vy = vertical() * CX_FLY.VertSpeed
		if vy ~= 0 then dir = dir + Vector3.new(0, vy, 0) end

		local target = root.Position
		if dir.Magnitude >= 0.01 then
			target = target + dir * dt
			CX_FLY.Steps = CX_FLY.Steps + 1
		end
		local cf = CFrame.new(target, target + root.CFrame.LookVector)
		pcall(function() root.CFrame = cf end)
		pcall(function() char:PivotTo(cf) end)
		CX_FLY._lastTarget = root.Position
		CX_FLY.LastErr = nil
	end

	function CX_FLY.Stop()
		CX_FLY.Enabled = false
		if CX_FLY._conn then
			pcall(function() CX_FLY._conn:Disconnect() end)
			CX_FLY._conn = nil
		end
		local char, hum = parts()
		if char then
			freezeAnim(char, false)
			if hum then
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics) end)
			end
		end
	end

	function CX_FLY.Set(on)
		if not on then CX_FLY.Stop() return true end
		if CX_FLY.Enabled then return true end
		if not CX_FLY.Start() then
			CX_FLY.LastErr = "没有角色"
			return false
		end
		CX_FLY.Enabled = true
		CX_FLY.LastErr = nil
		CX_FLY._conn = RunService.RenderStepped:Connect(function(dt)
			if CX_FLY.Enabled then pcall(CX_FLY.Step, dt) end
		end)
		return true
	end

	function CX_FLY.Status()
		return string.format("飞行=%s 冻结动画=%s | 位移=%d 被拉回=%d | %s",
			tostring(CX_FLY.Enabled), tostring(CX_FLY.FreezeAnim),
			CX_FLY.Steps, CX_FLY.Pullbacks, tostring(CX_FLY.LastErr or "ok"))
	end
end


