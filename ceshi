local function wrapSection(wsec)
	local s = {}
	function s:Toggle(o)
		return wsec:Toggle({ Title = o.Name, Desc = o.Desc, Value = o.Default, Callback = o.Callback })
	end
	function s:Slider(o)
		return wsec:Slider({
			Title = o.Name, Desc = o.Desc,
			Value = { Min = o.Min or 0, Max = o.Max or 100, Default = o.Default or o.Min or 0 },
			Callback = o.Callback,
		})
	end
	function s:Input(o)
		return wsec:Input({
			Title = o.Name, Desc = o.Desc,
			Value = o.Default, Placeholder = o.Placeholder, Callback = o.Callback,
		})
	end
	function s:Button(o)
		return wsec:Button({ Title = o.Name, Desc = o.Desc, Callback = o.Callback })
	end
	function s:Dropdown(o)
		return wsec:Dropdown({
			Title = o.Name, Desc = o.Desc,
			Values = o.Values, Value = o.Default, Callback = o.Callback,
		})
	end
	function s:Paragraph(o)
		return wsec:Paragraph({ Title = o.Name or "", Desc = o.Desc or o.Body or "" })
	end
	return s
end

local function wrapTab(wtab)
	local t = {}
	function t:Section(name)
		local title = name
		if type(name) == "table" then title = name.Name or name.Title end
		return wrapSection(wtab:Section({ Title = title, Opened = true }))
	end
	function t:Toggle(o) return wrapSection(wtab):Toggle(o) end
	function t:Button(o) return wrapSection(wtab):Button(o) end
	return t
end

function EclipseUI:CreateWindow()
	local w = { MainFrame = _ghost }
	function w:Tab(o)
		return wrapTab(_WINDOW:Tab({ Title = o.Name or o.Title, Icon = o.Icon }))
	end
	function w:Notify(o)
		return _WINDOW:Notify({ Title = o.Title, Content = o.Content, Duration = o.Duration or 5 })
	end
	return w
end


